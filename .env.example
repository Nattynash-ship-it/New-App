# Vela environment variables — every one is OPTIONAL.
# The app runs fully with none set (on-device engines + local fallbacks);
# each variable below "lights up" a feature when provided. Copy to
# .env.local for development, or add them in your host's dashboard for prod.

# --- AI (Smart Capture, Reverse Recipe Engine, NL Quick Add) ---
# Enables Claude for photo/PDF reading and smarter parsing. Without a key the
# app falls back to a deterministic on-device engine, so everything still
# works — text/voice capture just gets smarter with a key.
ANTHROPIC_API_KEY=

# --- Grocery delivery integrations ---
# Per-store webhook endpoints. Users can also paste these per device in
# Settings → Connections; the env vars are the deployment-wide default.
# Point them at a Zapier / Make automation or a partner API.
WHOLE_FOODS_WEBHOOK_URL=
ALDI_WEBHOOK_URL=
INSTACART_WEBHOOK_URL=

# --- Email & school sign-in (OAuth) ---
# When set, Settings → Connections builds the real consent URL for each
# provider. OAUTH_REDIRECT_URL must match the redirect URI registered with
# each provider and point at your deployed callback (see DEPLOY.md).
OAUTH_REDIRECT_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SCHOOL_OAUTH_CLIENT_ID=
SCHOOL_OAUTH_CLIENT_SECRET=
SCHOOL_OAUTH_AUTH_URL=

# --- Future: Supabase backend (see supabase/schema.sql) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
